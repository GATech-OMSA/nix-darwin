# shell-perf-budget.env — interactive zsh startup ceiling (milliseconds).
# Regenerate on this machine with: just perf-calibrate
#
# These are generous placeholder defaults so the gate does not false-positive
# before you calibrate. Run `just perf-calibrate` once on each machine to set a
# real, machine-specific budget from a fresh measurement (+25% headroom).
WARM_P50_MAX_MS=400
COLD_P95_MAX_MS=800
