# User Configuration Template
# Copy this to user-config.nix and customize for your user
# Generated by setup.sh or manually created

{
  # Your system username (e.g., "jimmy")
  # This will be used for /Users/{username} paths
  username = "REPLACE_USERNAME";

  # Your full name for git commits and system attribution
  # Example: "John Doe"
  fullName = "REPLACE_FULLNAME";

  # Your email address for git commits
  # Example: "john.doe@example.com"
  email = "REPLACE_EMAIL";

  # Corporate proxy configuration (optional, mainly for work profiles)
  # Uncomment and configure if you're behind a corporate proxy
  # proxies = {
  #   # Go module proxy (for sops-nix and other Go-based tools)
  #   go = {
  #     enabled = true;
  #     url = "https://nexus.example.com/repository/duke-cne-golang/";
  #     private = "github.com/my-corp/";  # Comma-separated list of private module prefixes
  #   };
  #
  #   # Python package proxy
  #   python = {
  #     enabled = false;
  #     url = "https://nexus.example.com/repository/pypi-proxy/simple";
  #     trustedHost = "nexus.example.com";  # For --trusted-host flag
  #   };
  #
  #   # NPM package proxy
  #   npm = {
  #     enabled = false;
  #     url = "https://nexus.example.com/repository/npm-proxy/";
  #   };
  #
  #   # Maven/Gradle proxy (for Java development)
  #   maven = {
  #     enabled = false;
  #     url = "https://nexus.example.com/repository/maven-public/";
  #   };
  # };
}
