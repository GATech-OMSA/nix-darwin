# config/machine-config.nix.template
#
# Template for machine-specific configuration
# Copy to machine-config.nix and customize

{
  # Machine identity (hardware + profile suffix, e.g., "macbook-pro-m1-personal")
  machineId = "CHANGE-ME";  # Example: "macbook-pro-m1-personal" or "macbook-pro-m3-work";

  # Profile selection
  profileName = "personal";  # Options: "personal" | "work" | "minimal"

  # Machine metadata
  description = "CHANGE-ME";  # Example: "Jimmy's work laptop"
  expectedHostname = "CHANGE-ME";  # Example: "mbp-work"

  # System architecture
  system = "aarch64-darwin";  # Or "x86_64-darwin" for Intel Macs

  # Optional: disable Home Manager if it causes issues
  # enableHomeManager = false;

  # Optional: skip Go packages if corporate proxy blocks Go module downloads
  # skipGoPackages = true;

  # Profile-specific overrides
  profileOverrides = {};
}
