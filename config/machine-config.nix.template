# Machine Configuration Template
# Copy this to machine-config.nix and customize for this machine
# Generated by setup.sh or manually created

{
  # Persistent machine identifier (never changes, even if hostname changes)
  # Example: "mbp-jimmy-2024", "work-macbook-pro"
  machineId = "REPLACE_MACHINE_ID";

  # Machine type determines which mixins and settings are applied
  # Options: "work" | "personal" | "minimal"
  machineType = "REPLACE_MACHINE_TYPE";

  # Human-readable description of this machine
  # Example: "Personal MacBook Pro M2", "Work MacBook Air"
  description = "REPLACE_DESCRIPTION";

  # Expected hostname (may change, used for validation only)
  # Get current hostname with: hostname | sed 's/\.local$//'
  expectedHostname = "REPLACE_HOSTNAME";

  # Mixins to apply for this machine
  # Common combinations:
  #   Personal: [ "base" "dev" "personal" ]
  #   Work:     [ "base" "dev" "work" ]
  #   Minimal:  [ "base" ]
  mixins = [ "REPLACE_MIXINS" ];

  # System architecture
  # Options: "aarch64-darwin" (Apple Silicon M1/M2/M3)
  #          "x86_64-darwin"  (Intel)
  # Detect with: uname -m | sed 's/arm64/aarch64-darwin/;s/x86_64/x86_64-darwin/'
  system = "REPLACE_SYSTEM_ARCH";
}
