# ============================================================================
# WORK MACHINE CONFIGURATION TEMPLATE
# ============================================================================
#
# This file should be copied to: home/_mixins/generated/work-<username>.nix
# Then customize for your work environment.
#
# INSTRUCTIONS:
# 1. Copy this file:
#    cp home/_mixins/generated/work.nix.template home/_mixins/generated/work-<username>.nix
#
# 2. Update flake.nix to import your file:
#    Replace: ./home/_mixins/work.nix
#    With:    ./home/_mixins/generated/work-<username>.nix
#
# 3. Customize the sections below:
#    - AWS configuration (if using corporate CA)
#    - Work-specific packages
#    - Project directory shortcuts
#    - Database instances
#    - Token helpers
#
# 4. Create accounts.json (optional, for AWS multi-role):
#    cp home/_mixins/generated/accounts.json.template ~/.aws/accounts.json
#    Edit ~/.aws/accounts.json with your AWS accounts
#
# 5. Rebuild:
#    nix-rebuild
#
# ============================================================================

{ config, pkgs, lib, myLib, ... }:

{
  # ============================================================================
  # AWS CLI CONFIGURATION
  # ============================================================================
  # If your work environment requires a corporate CA certificate bundle,
  # uncomment and update the path below:

  # programs.aws = {
  #   caBundle = "~/.config/certs/cacert.pem";
  # };

  # ============================================================================
  # WORK-SPECIFIC PACKAGES
  # ============================================================================
  # Add packages needed for your work environment.
  # Common examples included below.

  home.packages = with pkgs; [
    # ODBC drivers and database clients (uncomment if needed)
    # unixODBC           # ODBC driver manager
    # freetds            # ODBC for SQL Server
    # postgresql_16      # PostgreSQL client + libpq

    # Database CLI tools (uncomment if needed)
    # pgcli              # PostgreSQL CLI with auto-completion
    # mycli              # MySQL/MariaDB CLI

    # Add your work-specific packages here:
    # terraform
    # kubectl
    # aws-cli
    # docker
  ];

  # ============================================================================
  # MACHINE DETECTION
  # ============================================================================
  # Sets MACHINE_MODE=work for shell scripts and functions.
  # This enables work-specific aliases, functions, and AWS helpers.

  home.sessionVariables = {
    MACHINE_MODE = "work";

    # AWS_PROFILE - Auto-restored from ~/.aws/.last_profile on shell start
    # Managed by: awsuse <project> <env> [role]
    # Examples:
    #   awsuse myproject dev
    #   awsuse mp sbx developer
    #   awslogin mp qa

    # ODBC Configuration (uncomment if using ODBC)
    # ODBCSYSINI = "/usr/local/etc";
    # ODBCINI = "/usr/local/etc/odbc.ini";

    # Add your custom environment variables here:
  };

  # ============================================================================
  # PROJECT DIRECTORY SHORTCUTS
  # ============================================================================
  # Create quick navigation aliases for your project directories.
  # Pattern: f<name> = "cd ~/Dev/<project-name>"
  #
  # Example usage:
  #   fproj1     → cd ~/Dev/project1
  #   fapi       → cd ~/Dev/api-service

  programs.zsh.shellAliases = {
    # Project directory shortcuts (customize for your projects)
    # fproj1 = "cd ~/Dev/project1";
    # fproj2 = "cd ~/Dev/project2";
    # fapi = "cd ~/Dev/api-service";
    # fdocs = "cd ~/Dev/documentation";
    # fscripts = "cd ~/Dev/scripts";
  };

  # ============================================================================
  # CUSTOM SHELL FUNCTIONS
  # ============================================================================
  # Add custom shell functions for your work environment.

  programs.zsh.initContent = ''
    # ==================================================
    # CUSTOM WORK FUNCTIONS
    # ==================================================
    # Add your custom functions here
    #
    # Example:
    # function myfunction() {
    #   echo "Hello from custom function"
    # }

    # ==================================================
    # AWS HELPER FUNCTIONS
    # ==================================================
    # AWS functions read from ~/.aws/accounts.json for project configuration.
    #
    # Prerequisites:
    # 1. Create ~/.aws/accounts.json (see accounts.json.template)
    # 2. Configure AWS SSO profiles in ~/.aws/config
    #
    # Usage:
    #   awsuse <project|alias> <env> [role]
    #   awslogin <project|alias> <env> [role]
    #   awswho, awslist, awswhere, awscheck
    #
    # Examples:
    #   awsuse myproject dev                # Switch to myproject dev (default role)
    #   awsuse mp dev developer             # Switch to myproject dev (developer role)
    #   awslogin myproject prod             # Login to myproject prod + SSO
    #
    # Generated aliases from accounts.json:
    #   mpdev, mpqa, mpprod, mpdev-developer, etc.

    ${myLib.aws.mkAwsAccountHelper}
    ${myLib.aws.mkAwsInfoCommands}
    ${myLib.aws.mkAwsSearchCommands}
    ${myLib.aws.mkAwsProfileAutoRestore}

    # ==================================================
    # DATABASE INSTANCE CONNECTORS
    # ==================================================
    # Pattern: dbconnect-<instance> <env>
    #
    # Examples:
    #   dbconnect-mydb dev         → Connect to mydb (dev)
    #   dbconnect-proddb prod      → Connect to proddb (prod)
    #
    # Credentials: Loaded from SOPS-encrypted secrets
    # Rotation: Run setup.sh to update secrets
    #
    # Required env vars per instance (example for mydb prod):
    #   MYDB_PROD_USERNAME, MYDB_PROD_PASSWORD, MYDB_PROD_HOST,
    #   MYDB_PROD_PORT, MYDB_PROD_SERVICE (Oracle) or MYDB_PROD_DATABASE (PostgreSQL/MySQL)
    #
    # Customize the list below for your database instances:

    ${myLib.database.mkDatabaseInstances [
      # Example: Oracle Database
      # {
      #   instance = "mydb";
      #   type = "oracle";
      #   environments = [ "dev" "qa" "prod" ];
      #   description = "My Oracle Database";
      # }

      # Example: PostgreSQL Database
      # {
      #   instance = "pgdb";
      #   type = "postgres";
      #   environments = [ "dev" "prod" ];
      #   description = "My PostgreSQL Database";
      # }

      # Example: SQL Server Database
      # {
      #   instance = "mssqldb";
      #   type = "mssql";
      #   environments = [ "qa" "prod" ];
      #   description = "My SQL Server Database";
      # }

      # Example: MySQL Database
      # {
      #   instance = "mysqldb";
      #   type = "mysql";
      #   environments = [ "dev" "qa" "prod" ];
      #   description = "My MySQL Database";
      # }

      # Add your database instances here
    ]}

    ${myLib.database.mkInstanceList [
      # List your instances here for the dblist command
      # { instance = "mydb"; type = "oracle"; environments = [ "dev" "qa" "prod" ]; description = "My Oracle DB"; }
      # { instance = "pgdb"; type = "postgres"; environments = [ "dev" "prod" ]; description = "My PostgreSQL DB"; }
    ]}

    # ==================================================
    # TOKEN HELPERS
    # ==================================================
    # Usage: <name>-token
    # Tokens managed via SOPS encryption in secrets.yaml
    # Includes: File permission validation (600)
    #
    # Customize the list below for your tokens:

    ${myLib.database.mkTokenHelpers [
      # Example tokens
      # {
      #   name = "git";
      #   description = "Git token";
      #   file = "git_token";
      # }
      # {
      #   name = "terraform";
      #   description = "HCP Terraform token";
      #   file = "hcp_terraform_token";
      # }
      # {
      #   name = "jira";
      #   description = "Jira API token";
      #   file = "jira_api_token";
      # }

      # Add your token helpers here
    ]}
  '';
}
