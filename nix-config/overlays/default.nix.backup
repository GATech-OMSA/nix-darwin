# Overlays - Package Overrides and Customizations
#
# Purpose: Modify existing nixpkgs packages without forking nixpkgs
# Usage: Import in flake.nix to apply customizations

{ inputs, userConfig }:

let
  # Extract proxy configuration from userConfig
  goProxyConfig = userConfig.proxies.go or { enabled = false; };
  goProxyEnabled = goProxyConfig.enabled or false;
  goProxyUrl = if goProxyEnabled then goProxyConfig.url else "https://proxy.golang.org";
  goPrivate = goProxyConfig.private or "";

  # Debug: Print proxy configuration at evaluation time
  _ = builtins.trace "=== OVERLAY: Go Proxy Configuration ==="
      (builtins.trace "Enabled: ${toString goProxyEnabled}"
      (builtins.trace "GOPROXY will be: ${goProxyUrl}"
      (builtins.trace "GOPRIVATE will be: ${goPrivate}"
      (builtins.trace "=============================" null))));

in [
  # ============================================
  # GO PROXY CONFIGURATION (CORPORATE PROXY)
  # ============================================
  # Override buildGoModule to inject proxy settings into all Go builds
  in [
  # ============================================
  # GO PROXY CONFIGURATION (CORPORATE PROXY)
  # ============================================
  # TODO: Need to find proper way to override buildGoModule for corporate proxy
  # Current approaches tried:
  # 1. Overlay wrapping buildGoModule - breaks package evaluation
  # 2. nix.settings.sandbox = "relaxed" - doesn't pass env vars to build
  # 3. environment.variables - doesn't affect nix build sandbox
  #
  # Temporary solution: Disabled SOPS-NIX until we can resolve Go proxy issue
  # Possible future solutions:
  # - Use pre-built SOPS from cache
  # - Build SOPS outside nix and import binary
  # - Configure system-wide Go proxy at nix-daemon level
  # ============================================
  # PYTHON VERSION PINNING
  # ============================================
  # Pin Python 3.13 to prevent breaking changes from nixpkgs-unstable updates
  (final: prev: {
    # Pin to Python 3.13.x - update version as needed for security patches
    # Check current version: nix eval nixpkgs#python313.version
    python313 = prev.python313.overrideAttrs (old: {
      # Uncomment to pin to specific version:
      # version = "3.13.0";
      # Note: May require updating hash if pinning exact version
    });
  })

  # ============================================
  # MICROMAMBA FIX (BROKEN IN NIXPKGS)
  # ============================================
  # Status: Micromamba 1.5.8 build BROKEN on macOS
  # Error: Compilation failure with fmt library formatter
  # Last tested: 2025-11-02
  #
  # Build error:
  #   error: no viable conversion from 'const fmt::formatter<mamba::specs::Version>'
  #   to 'fmt::detail::value<fmt::context>'
  #
  # Workaround: Using Homebrew
  #   - See modules/darwin/homebrew.nix (micromamba in brews list)
  #   - Command: brew install micromamba
  #
  # Tracking:
  #   - Nixpkgs issue: https://github.com/NixOS/nixpkgs/issues/micromamba
  #   - When fixed upstream, uncomment and test:
  #
  # (final: prev: {
  #   micromamba = prev.micromamba.overrideAttrs (old: {
  #     # Try newer version or apply patch
  #   });
  # })

  # ============================================
  # GO PROXY CONFIGURATION (CORPORATE PROXY)
  # ============================================
  # Issue: Go builds (like sops-install-secrets) try to reach proxy.golang.org
  # which is blocked by corporate firewall, causing builds to hang or fail
  #
  # Solution: Configure nixpkgs to use corporate Nexus proxy for Go modules
  # This is now handled via nixpkgs.config in flake.nix
  # Configuration comes from user-config.nix (proxies.go)
  #
  # See flake.nix for the actual configuration using:
  #   nixpkgs.config.packageOverrides

  # ============================================
  # ADDITIONAL CUSTOMIZATIONS
  # ============================================
  # Add more overlays as needed for:
  # - Package feature flags
  # - Build optimizations
  # - Custom patches
  # - Tool consolidation
]
