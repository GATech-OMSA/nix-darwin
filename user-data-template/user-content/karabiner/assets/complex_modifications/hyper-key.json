{
  "title": "Hyper Key (Caps Lock → Cmd+Opt+Ctrl+Shift)",
  "rules": [
    {
      "description": "Caps Lock → Hyper Key (⌘+⌥+⌃+⇧). Tap for Escape.",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "left_shift",
              "modifiers": ["left_command", "left_control", "left_option"]
            }
          ],
          "to_if_alone": [
            {
              "key_code": "escape"
            }
          ]
        }
      ]
    }
  ]
}
