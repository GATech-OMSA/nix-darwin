{
  "title": "App Launching (Hyper + Keys)",
  "rules": [
    {
      "description": "Hyper + T → Launch/Focus iTerm2",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "t",
            "modifiers": {
              "mandatory": ["command", "option", "control", "shift"]
            }
          },
          "to": [
            {
              "shell_command": "open -a 'iTerm'"
            }
          ]
        }
      ]
    },
    {
      "description": "Hyper + B → Launch/Focus Safari",
