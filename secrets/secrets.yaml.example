# Example Secrets File
# This is a TEMPLATE - copy to hosts/<hostname>/secrets.yaml and encrypt with sops
#
# To create encrypted secrets:
# 1. Ensure you have generated your age key (see SETUP.md)
# 2. Update .sops.yaml with your public age key
# 3. Run: sops hosts/mbp-jimmy/secrets.yaml
# 4. Paste the content below, save, and it will be encrypted automatically

# Environment secrets for .zsh_secrets
# These will be automatically placed in ~/.zsh_secrets
zsh_secrets: |
  # API Keys for Development
  export OPENAI_API_KEY="sk-..."
  export ANTHROPIC_API_KEY="sk-ant-..."
  export HUGGINGFACE_TOKEN="hf_..."

  # GitHub
  export GITHUB_TOKEN="ghp_..."

  # Personal AWS (IAM-based keys)
  export AWS_ACCESS_KEY_ID="AKIA..."
  export AWS_SECRET_ACCESS_KEY="..."

  # Other services
  export SOME_OTHER_API_KEY="..."

# SSH Private Key
# This will be placed in ~/.ssh/id_ed25519
ssh_private_key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAA...
  ...paste your full private key here...
  -----END OPENSSH PRIVATE KEY-----

# SSH Public Key (optional - not secret, but convenient)
ssh_public_key: |
  ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... your-email@example.com

# AWS Credentials File
# This will be placed in ~/.aws/credentials
aws_credentials: |
  [default]
  aws_access_key_id = AKIA...
  aws_secret_access_key = ...

  [personal]
  aws_access_key_id = AKIA...
  aws_secret_access_key = ...

  [another-profile]
  aws_access_key_id = AKIA...
  aws_secret_access_key = ...

# Docker Config (for registry authentication)
# This will be placed in ~/.docker/config.json
docker_config: |
  {
    "auths": {
      "https://index.docker.io/v1/": {
        "auth": "base64encodedcredentials"
      },
      "ghcr.io": {
        "auth": "base64encodedcredentials"
      }
    }
  }

# GPG Key (optional)
gpg_private_key: |
  -----BEGIN PGP PRIVATE KEY BLOCK-----
  ...
  -----END PGP PRIVATE KEY BLOCK-----

# Certificate files (optional)
ssl_cert: |
  -----BEGIN CERTIFICATE-----
  ...
  -----END CERTIFICATE-----

ssl_key: |
  -----BEGIN PRIVATE KEY-----
  ...
  -----END PRIVATE KEY-----

# Work-specific secrets (for mbp-work)
# work_api_key: "..."
# work_database_url: "postgresql://..."
# work_vpn_credentials: "..."

# Notes:
# - All values are encrypted by sops before being committed to git
# - Without your age private key, these cannot be decrypted
# - Backup your ~/.config/sops/age/keys.txt file securely!
# - Each machine needs its own age key
# - You can add any secret here and reference it in your host config
