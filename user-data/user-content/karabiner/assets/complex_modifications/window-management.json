{
  "title": "Window Management (Hyper + Keys)",
  "rules": [
    {
      "description": "Hyper + Left Arrow → Move window to left half",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_arrow",
            "modifiers": {
              "mandatory": ["command", "option", "control", "shift"]
            }
          },
          "to": [
            {
              "shell_command": "open -g rectangle://left-half"
            }
          ]
        }
      ]
    },
    {
      "description": "Hyper + Right Arrow → Move window to right half",
      "manipulators": [
        {
          "type": "basic",
