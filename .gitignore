# Nix build results
result
result-*

# Secrets (keep encrypted versions, ignore unencrypted)
secrets/secrets.yaml.dec
secrets/*.dec
*.key
*.age

# Ignore template file (unencrypted example)
secrets/secrets.yaml

# Keep encrypted secrets (these are safe to commit)
!hosts/*/secrets.yaml
!secrets/.sops.yaml

# ==================================================
# CREDENTIAL PROTECTION (Added 2024-11-03)
# ==================================================
# These directories contain plaintext credentials
# managed by sops-nix - NEVER commit
.db/                      # Database connection files (legacy, file-based)
.tokens/                  # API tokens
.credentials/             # General credentials
.secrets/credentials.env  # Enterprise credentials (unencrypted)
!.secrets/credentials.env.enc  # Keep encrypted version

# AWS credentials (unencrypted)
.aws/credentials

# User data secrets
user-data/secrets/
user-data/app-configs/claude.json    # Contains PII (email, UUIDs)
user-data/user-content/claude/       # Claude Code user-content (todos, etc.)

# Credential file patterns (various formats)
*_credentials.txt
*_credentials.json
*_credentials.yaml
*_password.txt
*_secrets.txt

# SSH keys (unencrypted - prefer sops-nix encrypted versions)
id_rsa
id_dsa
id_ecdsa
id_ed25519
!*.pub    # Allow public keys

# Home Manager backup files
*.hm-backup

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp

# Logs
*.log

# Obsidian
.obsidian

# Planning notes
Planning

# Claude
.claude/
claudedocs/
CLAUDE.md
# Cursor
.cursor/

# MCP
.serena/
