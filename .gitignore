# Nix build results
result
result-*

# Temporary cleanup directory
.temp/

# Archived/deprecated documentation (preserved but not committed)
.deprecate/

# Claude documentation structure
claudedocs/planning         # Local planning files (ACTIVE.md, BACKLOG.md, projects/, archive/)
claudedocs/reference        # Reference documentation (committed in docs/work/ instead)

# Machine type override (for local testing)
hosts/local-override.nix

# User/machine config (generated by setup.sh)
# Note: config files are now tracked for full reproducibility
# Templates (.template files) serve as documentation

# Machine-specific workspace directories (generated during setup)
# Pattern matches: workspace/macbook-pro-m1/, workspace/macbook-air-m2/, etc.
# Template (workspace-template/) is tracked
workspace/*/
!workspace-template/

# Secrets (keep encrypted versions, ignore unencrypted)
*.key
*.age

# Ignore unencrypted template file
secrets/secrets.yaml

# Keep encrypted secrets (these are safe to commit)
!hosts/*/secrets.yaml
!secrets/.sops.yaml

# Ignore secrets backup files (generated by backup-secrets.sh and edit-secrets.sh)
secrets.yaml.backup-*
**/secrets.yaml.backup-*

# ==================================================
# CREDENTIAL PROTECTION (Added 2024-11-03)
# ==================================================
# These directories contain plaintext credentials
# managed by sops-nix - NEVER commit
.db/                      # Database connection files (legacy, file-based)
.tokens/                  # API tokens
.credentials/             # General credentials
.secrets/credentials.env  # Enterprise credentials (unencrypted)
!.secrets/credentials.env.enc  # Keep encrypted version

# AWS credentials (unencrypted)
.aws/credentials

# Workspace secrets and PII (gitignored by workspace/*/ pattern above)
# Examples:
#   workspace/macbook-pro-m1/app-configs/claude.json (PII: email, UUIDs)
#   workspace/macbook-pro-m1/user-content/claude/ (todos, session data)
#   workspace/macbook-pro-m1/backups/ (age key backups)

# Credential file patterns (various formats)
*_credentials.txt
*_credentials.json
*_credentials.yaml
*_password.txt
*_secrets.txt

# SSH keys (unencrypted - prefer sops-nix encrypted versions)
id_rsa
id_dsa
id_ecdsa
id_ed25519
!*.pub    # Allow public keys

# Home Manager backup files
*.hm-backup

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp

# Logs
*.log

# Obsidian
.obsidian

# Claude
.claude/

# AWS directory (contains credentials and user-specific config)
.aws/

# Cursor
.cursor/

# MCP
.serena/
/docs/learning/
